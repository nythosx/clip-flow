{
  "manifest_version": 3,
  "name": "ClipFlow AI Engine",
  "version": "1.0",
  "description": "Drives ClipFlow's 3 AI functions (Smart Trimmer, Clip Finder, Caption Generator) via DeepSeek chat.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      }
    }
  },
  "action": {
    "default_title": "ClipFlow AI Engine",
    "default_popup": "popup.html"
  },
  "key": ""
}
